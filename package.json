{
  "$schema": "https://json.schemastore.org/package",
  "name": "jitsi-outlook-addin",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Addin-TaskPane.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "outlook",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "start": "office-addin-debugging start manifest.xml",
    "start:desktop": "office-addin-debugging start manifest.xml desktop",
    "start:web": "office-addin-debugging start manifest.xml web",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate",
    "watch": "webpack --mode development --watch",
    "test": "jest",
    "test-config": "ts-node build-utils/test-footer-config.ts"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@jridgewell/source-map": "^0.3.11",
    "@types/jest": "^30.0.0",
    "@types/office-js": "^1.0.604",
    "@types/office-runtime": "^1.0.40",
    "acorn": "^8.17.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-office-addins": "^4.0.7",
    "file-loader": "^6.2.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "office-addin-cli": "^2.0.10",
    "office-addin-debugging": "^6.1.1",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-lint": "^3.0.10",
    "office-addin-manifest": "^2.1.5",
    "office-addin-mock": "^3.0.10",
    "office-addin-prettier-config": "^2.0.4",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "5.2.5",
    "xhr-mock": "^2.5.1"
  },
  "prettier": {
    "plugins": [
      "office-addin-prettier-config"
    ],
    "tabWidth": 2,
    "printWidth": 200
  },
  "browserslist": [
    "ie 11"
  ]
}
